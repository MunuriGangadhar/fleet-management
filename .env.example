# ── Client-side (exposed to the browser via Vite, safe to be public) ──────────
# Found in Supabase Dashboard → Project Settings → Data API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Found in Supabase Dashboard → Project Settings → API Keys → "anon" "public" key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server-side only (used by scripts/seed.ts, NEVER imported by app code) ────
# Same URL as above
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Found in Supabase Dashboard → Project Settings → API Keys → "service_role" "secret" key
# This key bypasses Row Level Security. Keep it out of the browser bundle and out of git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Demo operator account the seed script creates for you (used to log in to the app)
SEED_DEMO_EMAIL=operator@fleetpulse.demo
SEED_DEMO_PASSWORD=FleetDemo!2024
